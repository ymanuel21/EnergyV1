generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id                 String   @id
  slug               String   @unique
  name               String
  description        String
  price              Int
  originalPrice      Int?
  priceDisplayMode   String?  // null=use global | SHOW_PRICE|CONTACT_FOR_PRICE|REQUEST_QUOTE|STARTING_FROM|CUSTOM_TEXT
  customPriceLabel   String?  // label when mode=CUSTOM_TEXT
  stock              Int      @default(0)
  sku                String?
  model              String?
  weight             Float?
  warranty           String?
  condition          String?
  images             Json     @default("[]")
  badges             Json     @default("[]")
  specifications     Json     @default("[]")
  downloads          Json     @default("[]")
  affiliateCommission Json?
  isActive           Boolean  @default(true) @map("is_active")
  status             String   @default("published") // draft | published | archived
  draftData          Json     @default("{}")        // unpublished changes stored here
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  brandId      String    @map("brand_id")
  brand        Brand     @relation(fields: [brandId], references: [id])

  // Legacy single-category field — kept for backward compat during transition
  categoryId   String?   @map("category_id")

  // Many-to-many with categories
  categories   ProductCategory[]

  // Many-to-many with badges
  badgeRelations ProductBadge[]

  // Related products
  relations    ProductRelation[]  @relation("ProductRelations")
  referencedBy ProductRelation[]  @relation("RelatedProductRef")

  // Analytics events
  events       ProductEvent[]

  @@index([brandId])
  @@index([isActive])
  @@map("products")
}

model ProductCategory {
  productId  String
  categoryId String

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category  Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

model Category {
  id         String     @id
  slug       String     @unique
  name       String
  sortOrder  Int        @default(0) @map("sort_order")
  isActive   Boolean    @default(true) @map("is_active")

  parentId   String?    @map("parent_id")
  parent     Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryTree")

  // Many-to-many with products
  products   ProductCategory[]

  @@index([isActive])
  @@index([parentId])
  @@map("categories")
}

model Brand {
  id        String    @id
  slug      String    @unique
  name      String
  logo      String?
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")

  products  Product[]

  @@index([isActive])
  @@map("brands")
}

model Article {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  excerpt     String?
  content     String
  category    String?
  author      String   @default("Tim EBTPlaza")
  image       String?
  readTime    Int?     @map("read_time")
  isPublished Boolean  @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("articles")
}

model Faq {
  id        Int     @id @default(autoincrement())
  question  String
  answer    String
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  @@map("faqs")
}

model StaticPage {
  id        String   @id
  slug      String   @unique
  title     String
  content   String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pages")
}

model SiteSetting {
  key   String @id
  value String

  @@map("settings")
}

model Banner {
  id        String  @id
  type      String  @default("hero")
  title     String?
  src       String?
  image     String?
  alt       String?
  link      String?
  label     String?
  description String?
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  @@map("banners")
}

model Asset {
  id        String   @id @default(uuid())
  filename  String   @default("")  // original filename
  data      String                 // base64 encoded image data
  mimeType  String   @map("mime_type")
  size      Int
  createdAt DateTime @default(now()) @map("created_at")

  @@map("assets")
}

model Badge {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  color       String   @default("#3B82F6")       // text color
  bgColor     String   @default("#EFF6FF") @map("bg_color") // background color
  icon        String?                              // optional emoji or icon name
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products    ProductBadge[]

  @@map("badges")
}

model ProductBadge {
  productId String
  badgeId   String

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  badge     Badge   @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([productId, badgeId])
  @@map("product_badges")
}

model ProductRelation {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation("ProductRelations", fields: [productId], references: [id], onDelete: Cascade)
  relatedProductId String
  relatedProduct   Product  @relation("RelatedProductRef", fields: [relatedProductId], references: [id], onDelete: Cascade)
  type             String   @default("recommended") // recommended | alternative | accessory
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())

  @@unique([productId, relatedProductId])
  @@index([productId])
  @@index([relatedProductId])
  @@map("product_relations")
}

model ProductEvent {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  eventType String   // VIEW | RFQ_START | RFQ_SUBMIT | COMPARE_ADD | DOWNLOAD
  sessionId String   @default("")
  metadata  Json     @default("{}") // { documentType, compareGroup, rfqItems, etc }
  createdAt DateTime @default(now())

  @@index([productId, eventType])
  @@index([productId, createdAt])
  @@index([eventType])
  @@index([createdAt])
  @@map("product_events")
}

model HomepageSection {
  id        String   @id @default(cuid())
  pageId    String?  // null = homepage, set = landing page
  type      String   // hero, category-grid, featured-products, brands, cta
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions  HomepageSectionVersion[]

  @@map("homepage_sections")
}

model HomepageSectionVersion {
  id          String   @id @default(cuid())
  sectionId   String
  section     HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  status      String   @default("draft") // draft | published | archived
  title       String?
  subtitle    String?
  settings    Json     @default("{}")
  publishedAt DateTime?
  createdBy   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sectionId, status])  // 1 draft + 1 published per section, ∞ archived
  @@map("homepage_section_versions")
}

model LandingPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @default("")
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("landing_pages")
}

model NavigationLink {
  id        String   @id @default(cuid())
  group     String   // header, footer_belanja, footer_layanan, utility, mobile
  label     String
  href      String
  sortOrder Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("navigation_links")
}

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  shortDescription String @default("")
  richDescription  String @default("")
  description String   @default("")   // kept for backward compat
  category    String   @default("residential")
  industry    String   @default("")
  systemType  String   @default("")   // On-Grid, Off-Grid, Hybrid
  capacity    String   @default("")
  pvModule    String   @default("")
  inverter    String   @default("")
  battery     String   @default("")
  location    String   @default("")
  customer    String   @default("")
  year        Int      @default(2025)
  coverImage  String   @default("")
  images      Json     @default("[]")
  highlights  Json     @default("[]") // array of highlight strings
  productIds  Json     @default("[]")
  storyData   Json     @default("{}")    // { challenge, solution, result }
  impactData  Json     @default("{}")    // { co2Reduction, annualSavings, energyGenerated }
  seoData     Json     @default("{}")    // { title, description, keywords, ogImage }
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  status      String   @default("published") // draft | published | archived
  draftData   Json     @default("{}")        // unpublished changes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("projects")
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  company   String   @default("")
  role      String   @default("")
  quote     String
  rating    Int      @default(5)
  photo     String   @default("")
  productIds Json    @default("[]")       // linked project IDs (backward compat name kept)
  featured  Boolean  @default(false)
  sortOrder Int      @default(0)          // display priority
  status    String   @default("draft")    // draft | review | published | archived
  draftData Json     @default("{}")       // unpublished changes
  published Boolean  @default(false)      // kept for backward compat
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonials")
}

model QuoteRequest {
  id        String   @id @default(cuid())
  name      String
  email     String   @default("")
  phone     String   @default("")
  company   String   @default("")
  message   String   @default("")
  status    String   @default("pending") // pending, contacted, survey_scheduled, proposal_sent, won, lost
  notes     String   @default("")
  followUps Json     @default("[]")       // [{ note, author, createdAt }]
  assignedTo String?                      // admin user ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("quote_requests")
}

model AdminUser {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String
  role        String   @default("editor") // owner, admin, editor, viewer
  permissions Json     @default("[]")     // explicit overrides: ["manage_products", "publish_content"]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("admin_users")
}

model Revision {
  id         String   @id @default(cuid())
  entityType String   // "product", "homepage_section", "navigation_link", "banner", etc.
  entityId   String
  data       Json     // full snapshot of entity at this point
  userId     String   @default("")
  userName   String   @default("")
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("revisions")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String   @default("")
  userName  String   @default("")
  action    String   // "create", "update", "delete", "publish", "restore"
  entity    String   // "product", "homepage_section", "navigation_link"
  entityName String  @default("")
  details   String   @default("")
  createdAt DateTime @default(now())

  @@map("activity_logs")
}

model Review {
  id          String   @id @default(cuid())
  entityType  String   // "product" | "project"
  entityId    String
  status      String   @default("pending") // pending | approved | rejected
  requestedBy String   @default("")
  reviewedBy  String?
  notes       String?
  requestedAt DateTime @default(now())
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([status])
  @@map("reviews")
}
