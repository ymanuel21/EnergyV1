generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id                 String   @id
  slug               String   @unique
  name               String
  description        String
  price              Int
  originalPrice      Int?
  stock              Int      @default(0)
  sku                String?
  model              String?
  weight             Float?
  warranty           String?
  condition          String?
  images             Json     @default("[]")
  badges             Json     @default("[]")
  specifications     Json     @default("[]")
  affiliateCommission Json?
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  brandId      String    @map("brand_id")
  brand        Brand     @relation(fields: [brandId], references: [id])

  // Legacy single-category field — kept for backward compat during transition
  categoryId   String?   @map("category_id")

  // Many-to-many with categories
  categories   ProductCategory[]

  @@map("products")
}

model ProductCategory {
  productId  String
  categoryId String

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category  Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

model Category {
  id         String     @id
  slug       String     @unique
  name       String
  sortOrder  Int        @default(0) @map("sort_order")
  isActive   Boolean    @default(true) @map("is_active")

  parentId   String?    @map("parent_id")
  parent     Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryTree")

  // Many-to-many with products
  products   ProductCategory[]

  @@map("categories")
}

model Brand {
  id        String    @id
  slug      String    @unique
  name      String
  logo      String?
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")

  products  Product[]

  @@map("brands")
}

model Article {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  excerpt     String?
  content     String
  category    String?
  author      String   @default("Tim EBTPlaza")
  image       String?
  readTime    Int?     @map("read_time")
  isPublished Boolean  @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("articles")
}

model Faq {
  id        Int     @id @default(autoincrement())
  question  String
  answer    String
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  @@map("faqs")
}

model StaticPage {
  id        String   @id
  slug      String   @unique
  title     String
  content   String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pages")
}

model SiteSetting {
  key   String @id
  value String

  @@map("settings")
}

model Banner {
  id        String  @id
  type      String  @default("hero")
  title     String?
  src       String?
  image     String?
  alt       String?
  link      String?
  label     String?
  description String?
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  @@map("banners")
}

model Asset {
  id        String   @id @default(uuid())
  data      String   // base64 encoded image data
  mimeType  String   @map("mime_type") // e.g. image/webp, image/png
  size      Int      // file size in bytes
  createdAt DateTime @default(now()) @map("created_at")

  @@map("assets")
}
