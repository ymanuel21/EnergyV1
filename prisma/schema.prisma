generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id                 String   @id
  slug               String   @unique
  name               String
  description        String
  price              Int
  originalPrice      Int?
  stock              Int      @default(0)
  sku                String?
  model              String?
  weight             Float?
  warranty           String?
  condition          String?
  images             Json     @default("[]")
  badges             Json     @default("[]")
  specifications     Json     @default("[]")
  affiliateCommission Json?
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  brandId      String    @map("brand_id")
  brand        Brand     @relation(fields: [brandId], references: [id])

  // Legacy single-category field — kept for backward compat during transition
  categoryId   String?   @map("category_id")

  // Many-to-many with categories
  categories   ProductCategory[]

  // Many-to-many with badges
  badgeRelations ProductBadge[]

  @@map("products")
}

model ProductCategory {
  productId  String
  categoryId String

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category  Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

model Category {
  id         String     @id
  slug       String     @unique
  name       String
  sortOrder  Int        @default(0) @map("sort_order")
  isActive   Boolean    @default(true) @map("is_active")

  parentId   String?    @map("parent_id")
  parent     Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryTree")

  // Many-to-many with products
  products   ProductCategory[]

  @@map("categories")
}

model Brand {
  id        String    @id
  slug      String    @unique
  name      String
  logo      String?
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")

  products  Product[]

  @@map("brands")
}

model Article {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  excerpt     String?
  content     String
  category    String?
  author      String   @default("Tim EBTPlaza")
  image       String?
  readTime    Int?     @map("read_time")
  isPublished Boolean  @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("articles")
}

model Faq {
  id        Int     @id @default(autoincrement())
  question  String
  answer    String
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  @@map("faqs")
}

model StaticPage {
  id        String   @id
  slug      String   @unique
  title     String
  content   String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pages")
}

model SiteSetting {
  key   String @id
  value String

  @@map("settings")
}

model Banner {
  id        String  @id
  type      String  @default("hero")
  title     String?
  src       String?
  image     String?
  alt       String?
  link      String?
  label     String?
  description String?
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  @@map("banners")
}

model Asset {
  id        String   @id @default(uuid())
  filename  String   @default("")  // original filename
  data      String                 // base64 encoded image data
  mimeType  String   @map("mime_type")
  size      Int
  createdAt DateTime @default(now()) @map("created_at")

  @@map("assets")
}

model Badge {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  color       String   @default("#3B82F6")       // text color
  bgColor     String   @default("#EFF6FF") @map("bg_color") // background color
  icon        String?                              // optional emoji or icon name
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products    ProductBadge[]

  @@map("badges")
}

model ProductBadge {
  productId String
  badgeId   String

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  badge     Badge   @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([productId, badgeId])
  @@map("product_badges")
}

model HomepageSection {
  id        String   @id @default(cuid())
  pageId    String?  // null = homepage, set = landing page
  type      String   // hero, category-grid, featured-products, brands, cta
  enabled   Boolean  @default(true)
  status    String   @default("published") // draft | published
  sortOrder Int      @default(0)
  title     String?
  subtitle  String?
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("homepage_sections")
}

model LandingPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @default("")
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("landing_pages")
}

model NavigationLink {
  id        String   @id @default(cuid())
  group     String   // header, footer_belanja, footer_layanan, utility, mobile
  label     String
  href      String
  sortOrder Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("navigation_links")
}
